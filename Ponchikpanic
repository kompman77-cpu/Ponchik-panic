function update(dt){ state.time+=dt; const f=dt/16.667;
player.wobble+=f*3.2;
const dx=player.tx-player.x, dy=player.ty-player.y;
player.x+=dx*Math.min(.22*f,1); player.y+=dy*Math.min(.22*f,1);
player.tilt=Math.max(-.35,Math.min(.35,(player.tx-player.x)*.011));
const sp=8.5*f;
if(state.keys['ArrowLeft']||state.keys['a']||state.keys['A'])player.tx-=sp;
if(state.keys['ArrowRight']||state.keys['d']||state.keys['D'])player.tx+=sp;
if(state.keys['ArrowUp']||state.keys['w']||state.keys['W'])player.ty-=sp;
if(state.keys['ArrowDown']||state.keys['s']||state.keys['S'])player.ty+=sp;
player.tx=Math.max(player.r,Math.min(W-player.r,player.tx));
player.ty=Math.max(player.r+60,Math.min(H-player.r,player.ty));
state.spawnTimer-=dt;
const interval=Math.max(300,900-(state.level-1)*72);
if(state.spawnTimer<=0){ spawn(); state.spawnTimer=interval; }
for(let i=state.items.length-1;i>=0;i--){ const it=state.items[i];
it.y+=it.vy*f; it.x+=it.vx*f; it.rot+=it.rotSpd*f; it.wob+=f*3;
if(it.x<it.r){it.x=it.r;it.vx*=-1;} if(it.x>W-it.r){it.x=W-it.r;it.vx*=-1;}
if(it.y>H+80){ if(!it.isRobot)state.combo=0; state.items.splice(i,1); continue; }
const ddx=it.x-player.x, ddy=it.y-player.y;
const d=Math.sqrt(ddx*ddx+ddy*ddy);
if(d<it.r+player.r*.78){
if(it.isRobot){ state.lives--; if(state.lives<0)state.lives=0; state.shake=22; state.flash=1; state.combo=0;
burst(it.x,it.y,'#ff3d6e',26); floatText(player.x,player.y-50,'-1 ❤','#ff3d6e');
Audio2.sfxHit(); state.items.splice(i,1);
if(state.lives<=0)return gameOver(); continue;
} else { state.combo++; state.comboTimer=1400;
const gained=Math.round(it.pts*(1+Math.min(state.combo,12)*.14));
state.score+=gained; burst(it.x,it.y,it.color,20);
floatText(it.x,it.y-10,'+'+gained,it.glow); Audio2.sfxCatch(state.combo);
if(state.combo>=3&&state.combo%3===0){ floatText(player.x,player.y-74,'КОМБО x'+state.combo+'!','#ffd93d'); Audio2.sfxCombo(state.combo); }
state.items.splice(i,1); continue; } } }
const nl=Math.floor(state.score/500)+1;
if(nl>state.level){ state.level=nl; Audio2.sfxLevelUp();
floatText(W/2,H/2-60,'УРОВЕНЬ '+state.level+'!','#5ee7ff');
for(let i=0;i<24;i++)burst(Math.random()*W,Math.random()*H*.5,'#5ee7ff',1); }
if(state.comboTimer>0){ state.comboTimer-=dt; if(state.comboTimer<=0)state.combo=0; }
for(let i=state.particles.length-1;i>=0;i--){ const p=state.particles[i];
p.x+=p.vx*f; p.y+=p.vy*f; if(!p.text)p.vy+=.19*f; p.life-=p.decay*f;
if(p.life<=0||p.y>H+140||p.y<-260||p.x<-160||p.x>W+160)state.particles.splice(i,1); }
if(state.shake>0)state.shake-=f; if(state.flash>0)state.flash-=.045*f; }

function drawHUD(){ ctx.save(); ctx.font='bold 22px Trebuchet MS'; ctx.textAlign='left';
ctx.fillStyle='#fff'; ctx.shadowColor='#ff6bcb'; ctx.shadowBlur=8;
