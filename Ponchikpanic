for(let i=0;i<this.pad.length;i++){ const p=this.pad[i];
p.o.frequency.setTargetAtTime(fs[i]*(i===0?.5:1)*(i===2?2:1),t,1.3);
p.g.gain.setTargetAtTime(.028,t,.9); } },
startMusic(){ this.init(); this.resume(); if(!this.enabled||this.musicTimer||document.hidden)return;
this.step=0;
const t0=this.ctx.currentTime;
this.musicGain.gain.cancelScheduledValues(t0);
this.musicGain.gain.setValueAtTime(0,t0); this.musicGain.gain.linearRampToValueAtTime(.3,t0+1.5);
const bass=[110,110,146.83,146.83,164.81,164.81,130.81,98,110,110,174.61,174.61,164.81,146.83,130.81,98];
const chords=[[220,277.18,329.63],[220,277.18,329.63],[293.66,349.23,440],[293.66,349.23,440],
[329.63,415.3,493.88],[329.63,415.3,493.88],[261.63,329.63,392],[196,246.94,293.66]];
const melA=[659.25,0,587.33,659.25,880,0,783.99,659.25,987.77,0,880,783.99,659.25,587.33,523.25,0,
587.33,0,659.25,0,880,987.77,0,880,783.99,659.25,0,587.33,659.25,0,523.25,0];
const melB=[0,0,783.99,0,880,0,1046.5,0,987.77,0,880,0,783.99,880,0,0,
659.25,0,0,783.99,0,880,0,987.77,1174.66,0,1046.5,0,987.77,0,880,0];
const arp=[220,329.63,440,554.37];
const tick=()=>{ if(!this.enabled||!this.ctx||this.ctx.state!=='running'){ this.stopMusic(); return; }
const s=this.step, ph=(s>>5)&3, b=(s>>3)&7, mel=ph===1?melB:melA;
if(s%8===0)this.padVoices(chords[b]);
this.tone(bass[b],this.tempo*.95,'triangle',.5,this.musicBus);
if(s%2===0)chords[b].forEach((f,i)=>this.tone(f,this.tempo*1.8,'sine',.12,this.musicBus,i*5));
const m=mel[s%32];
if(m){ this.tone(m,this.tempo*1.1,'square',.085,this.musicBus);
this.tone(m*2,this.tempo*.7,'sine',.04,this.musicBus,0,.012); }
if(ph===2&&s%4===2)this.tone(arp[(s>>1)%4],this.tempo*1.6,'triangle',.055,this.musicBus,0,.02);
if(ph===3&&s%4===0)this.tone(bass[b]*3,this.tempo*1.8,'sine',.045,this.musicBus,9,.03);
if(s%8===0)this.tone(58,.16,'sine',.3,this.musicBus);
if(s%4===2)this.tone(3000,.02,'square',.018,this.musicBus,0,.02);
this.step=(s+1)%128; };
tick(); this.musicTimer=setInterval(tick,this.tempo*1000); },
stopMusic(){ if(this.musicTimer){clearInterval(this.musicTimer); this.musicTimer=null;}
this.step=0; if(this.ctx&&this.pad.length){ const t=this.ctx.currentTime;
for(let i=0;i<this.pad.length;i++)this.pad[i].g.gain.setTargetAtTime(.0001,t,.35); } },
sfxCatch(c){ const b=660+Math.min(c,8)*55; this.tone(b,.09,'square',.22); this.tone(b*1.5,.13,'sine',.16,null,0,.04);
if(c>=2)this.tone(b*2,.1,'triangle',.07,null,0,.08); },
sfxCombo(c){ const b=520+Math.min(c,12)*40; [0,.06,.12].forEach((w,i)=>this.tone(b*(1+i*.26),.18,'triangle',.2,null,0,w)); },
sfxHit(){ this.tone(120,.35,'sawtooth',.4); this.tone(80,.45,'square',.3,null,0,.05); },
sfxLevelUp(){ [523.25,659.25,783.99,1046.5].forEach((f,i)=>this.tone(f,.22,'triangle',.28,null,0,i*.08)); },
sfxGameOver(){ [523.25,392,329.63,261.63,196].forEach((f,i)=>this.tone(f,.5,'sawtooth',.22,null,0,i*.17));
this.tone(65,1.2,'sine',.3,null,0,.1); },
