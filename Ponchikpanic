#game{display:block;position:fixed;inset:0;width:100vw;height:100vh;width:100dvw;height:100dvh;touch-action:none;
-webkit-user-select:none;user-select:none;-webkit-touch-callout:none}
#rotate{display:none;position:fixed;inset:0;z-index:60;background:#1a0b2e;color:#ffd93d;font-weight:bold;
align-items:center;justify-content:center;text-align:center;padding:24px;line-height:1.6;
