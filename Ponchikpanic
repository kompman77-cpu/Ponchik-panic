this.sfxGain=c.createGain(); this.sfxGain.gain.value=.5; this.sfxGain.connect(this.master);
const lp=c.createBiquadFilter(); lp.type='lowpass'; lp.frequency.value=2200; lp.Q.value=.6;
const sweep=c.createOscillator(); sweep.type='sine'; sweep.frequency.value=.05;
const sweepAmt=c.createGain(); sweepAmt.gain.value=1100; sweep.connect(sweepAmt); sweepAmt.connect(lp.frequency); sweep.start();
this.musicBus=c.createGain(); this.musicBus.gain.value=1;
this.musicBus.connect(lp); lp.connect(this.musicGain);
