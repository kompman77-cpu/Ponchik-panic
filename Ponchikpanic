</head>
<body>
<canvas id="game"></canvas>
<button id="pauseBtn" title="Пауза">⏸</button>
<button id="soundBtn" title="Звук">🔊</button>
<div id="rotate">Поверните устройство вертикально 📱</div>

<div class="overlay" id="startScreen">
<h1>🍩 ПОНЧИК-ПАНИКА</h1>
<p class="tagline">Ты — последний храбрый пончик. Роботы-пылесосы украли всю еду мира! Лови роллы и пиццу, уворачивайся от железяк и спаси гастрономическую вселенную.</p>
<button class="btn" id="startBtn">ИГРАТЬ ▶</button>
<div class="legend">
<div><span class="dot" style="background:#ff8f6b"></span> Лови роллы и пиццу</div>
<div><span class="dot" style="background:#7a8a99"></span> Беги от роботов</div>
<div><span class="dot" style="background:#ffd93d"></span> Собирай комбо</div>
</div>
<p class="controls-hint">🖱 Мышь / 📱 палец — води пончика &nbsp;|&nbsp; ⌨ Стрелки и A/D &nbsp;|&nbsp; P — пауза</p>
</div>

<div class="overlay hidden" id="pauseScreen">
<h1 style="font-size:clamp(1.9rem,7.5vw,3.2rem)">ПАУЗА</h1>
<button class="btn" id="resumeBtn">ПРОДОЛЖИТЬ ▶</button>
<button class="btn alt" id="quitBtn">В МЕНЮ</button>
</div>

<div class="overlay hidden" id="endScreen">
<h1 style="font-size:clamp(1.7rem,6.5vw,3rem)" id="endTitle">ИГРА ОКОНЧЕНА</h1>
<div class="final-score" id="endScore">0</div>
<div class="rank" id="endRank"></div>
<div class="best" id="endBest"></div>
<button class="btn" id="againBtn">ЕЩЁ РАЗ 🔄</button>
<button class="btn alt" id="menuBtn">В МЕНЮ</button>
</div>

<script>
/* ---------- МУЗЫКА И ЗВУКИ (Web Audio, без файлов) ---------- */
const Audio2={
ctx:null,master:null,musicGain:null,sfxGain:null,musicBus:null,pad:[],enabled:true,musicTimer:null,step:0,tempo:0.145,
init(){ if(this.ctx)return; const AC=window.AudioContext||window.webkitAudioContext; this.ctx=new AC(); const c=this.ctx;
this.master=c.createGain(); this.master.gain.value=.85; this.master.connect(c.destination);
