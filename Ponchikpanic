};

/* ---------- ДВИЖОК ---------- */
const canvas=document.getElementById('game'), ctx=canvas.getContext('2d');
let W=0,H=0,DPR=1,bgGrad=null,starLayer=null;
let rectL=0,rectT=0,rectW=1,rectH=1;
function buildBG(){ bgGrad=ctx.createLinearGradient(0,0,0,H);
bgGrad.addColorStop(0,'#1a0b2e'); bgGrad.addColorStop(.45,'#2d0f4e'); bgGrad.addColorStop(1,'#3d1560'); }
function buildStars(){ const sw=Math.max(1,Math.round(W*.5)), sh=Math.max(1,Math.round(H*.5));
starLayer=document.createElement('canvas'); starLayer.width=sw; starLayer.height=sh;
const g=starLayer.getContext('2d');
for(const s of stars){ g.globalAlpha=.6+Math.random()*.4; g.fillStyle=s.col;
g.beginPath(); g.arc(s.x*sw,s.y*sh,s.r*.55,0,7); g.fill(); }
g.globalAlpha=1; }
function measure(){ const b=canvas.getBoundingClientRect(); rectL=b.left; rectT=b.top;
rectW=b.width||W; rectH=b.height||H; }
function resize(){ DPR=Math.min(window.devicePixelRatio||1,1.5); var vv=window.visualViewport; W=vv?vv.width:window.innerWidth; H=vv?vv.height:window.innerHeight;
canvas.width=Math.round(W*DPR); canvas.height=Math.round(H*DPR);
ctx.setTransform(DPR,0,0,DPR,0,0); buildBG(); starLayer=null; measure();
player.tx=Math.max(player.r,Math.min(W-player.r,player.tx));
player.ty=Math.max(player.r+60,Math.min(H-player.r,player.ty));
player.x=Math.max(player.r,Math.min(W-player.r,player.x));
player.y=Math.max(player.r+60,Math.min(H-player.r,player.y)); }

const state={screen:'start',score:0,best:(()=>{try{return +(localStorage.getItem('donutBest')||0)}catch(e){return 0}})(),
combo:0,comboTimer:0,level:1,lives:3,maxLives:3,shake:0,flash:0,time:0,spawnTimer:0,items:[],particles:[],keys:{}};
const player={x:0,y:0,tx:0,ty:0,r:32,wobble:0,tilt:0};
let resizeTimer=0,endTimer=0;
window.addEventListener('resize',()=>{ clearTimeout(resizeTimer); resizeTimer=setTimeout(resize,140); });
window.addEventListener('orientationchange',()=>{ clearTimeout(resizeTimer); resizeTimer=setTimeout(()=>{resize();lockPortrait();},220); });
resize(); window.scrollTo(0,1); setTimeout(()=>window.scrollTo(0,0),100);

function resetGame(){ state.score=0;state.combo=0;state.comboTimer=0;state.level=1;state.lives=3;
state.shake=0;state.flash=0;state.time=0;state.spawnTimer=0;state.particles=[];state.items=[];
player.x=player.tx=W/2; player.y=player.ty=H-110; player.r=32; player.wobble=0; player.tilt=0; }

/* ---------- ЕДА: РОЛЛЫ И ПИЦЦА (Canvas 2D, спрайты) ---------- */
function hexA(h,a){ const n=parseInt(h.slice(1),16); return 'rgba('+((n>>16)&255)+','+((n>>8)&255)+','+(n&255)+','+a+')'; }
const RB=64;
function makeSprite(radius,pad,painter){ const size=Math.ceil(radius*2*pad);
const c=document.createElement('canvas'); c.width=c.height=size; const g=c.getContext('2d');
g.translate(size/2,size/2); painter(g,radius); return {img:c,size}; }
function paintGlow(g,R,glow){ const gr=g.createRadialGradient(0,0,R*.5,0,0,R*1.32);
gr.addColorStop(0,hexA(glow,.42)); gr.addColorStop(1,hexA(glow,0)); g.fillStyle=gr;
g.beginPath(); g.arc(0,0,R*1.32,0,7); g.fill(); }

function paintPizza(g,R,o){
paintGlow(g,R,o.glow);
const crust=g.createRadialGradient(-R*.3,-R*.3,R*.2,0,0,R);
crust.addColorStop(0,'#f6cf95'); crust.addColorStop(.72,'#e0a95f'); crust.addColorStop(1,'#b9782f');
