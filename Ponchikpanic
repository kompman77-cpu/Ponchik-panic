if(o.tomato)for(let i=0;i<4;i++){ const a=i*1.57+.5, px=Math.cos(a)*R*.5, py=Math.sin(a)*R*.5;
g.fillStyle='#d94f3d'; g.beginPath(); g.arc(px,py,R*.16,0,7); g.fill();
g.fillStyle='#e8756a'; g.beginPath(); g.arc(px,py,R*.115,0,7); g.fill();
