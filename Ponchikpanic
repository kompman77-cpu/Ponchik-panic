const fb=c.createGain(); fb.gain.value=.33;
const damp=c.createBiquadFilter(); damp.type='lowpass'; damp.frequency.value=2000;
const wet=c.createGain(); wet.gain.value=.3;
this.echo.connect(damp); damp.connect(fb); fb.connect(this.echo);
this.echo.connect(wet); wet.connect(this.musicGain);
lp.connect(this.echo);
for(let i=0;i<3;i++){ const o=c.createOscillator(), g=c.createGain();
o.type='sine'; o.detune.value=(i-1)*8; o.frequency.value=220*(i+1);
g.gain.value=.0001; o.connect(g); g.connect(this.musicBus); o.start();
const lfo=c.createOscillator(), la=c.createGain(); lfo.type='sine'; lfo.frequency.value=.06+i*.041;
la.gain.value=.03; lfo.connect(la); la.connect(g.gain); lfo.start();
this.pad.push({o,g}); } },
resume(){ if(this.ctx&&this.ctx.state==='suspended')this.ctx.resume(); },
tone(freq,dur,type,gain,dest,detune,when){ if(!this.ctx||!this.enabled||this.ctx.state!=='running')return;
const t=this.ctx.currentTime+(when||0);
const o=this.ctx.createOscillator(),g=this.ctx.createGain();
