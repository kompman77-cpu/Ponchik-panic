g.fillStyle=sauce; g.beginPath();
for(let i=0;i<=20;i++){ const a=i/20*Math.PI*2, rr=R*.84*(1+Math.sin(a*3+i)*.035);
i?g.lineTo(Math.cos(a)*rr,Math.sin(a)*rr):g.moveTo(Math.cos(a)*rr,Math.sin(a)*rr); }
g.closePath(); g.fill();
for(let i=0;i<13;i++){ const a=i*2.1, rr=R*.58*Math.sqrt(((i*3)%11)/11);
const bx=Math.cos(a)*rr, by=Math.sin(a)*rr, br=R*(.15+((i*37)%10)/45);
const cg=g.createRadialGradient(bx-br*.3,by-br*.3,br*.08,bx,by,br);
cg.addColorStop(0,o.cheeseHot||'#ffeaa6'); cg.addColorStop(1,o.cheeseCold||'#e6b64c');
g.fillStyle=cg; g.beginPath(); g.arc(bx,by,br,0,7); g.fill(); }
g.fillStyle='rgba(230,182,76,.85)';
for(let i=0;i<6;i++){ const a=i*1.7+.3;
g.beginPath(); g.arc(Math.cos(a)*R*.72,Math.sin(a)*R*.72,R*.11,0,7); g.fill(); }
g.fillStyle='rgba(88,48,18,.42)';
for(let i=0;i<7;i++){ const a=i*1.9+.6, rr=R*(.45+(i%3)*.15);
